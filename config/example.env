# MySQL connection for the running app (python -m equipment.app).
# pytest does not use these values; unit tests use an in-memory database.
# EC2 user-data sets the MySQL root account to MYSQL_PASSWORD on first boot.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<replace with your password>
MYSQL_DATABASE=equipment
