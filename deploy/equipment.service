[Unit]
Description=Equipment locker (gunicorn)
After=network-online.target mysql-local.service
Wants=network-online.target
Requires=mysql-local.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/sport-equipment-monolith
EnvironmentFile=/home/ec2-user/sport-equipment-monolith/.env
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStartPre=/home/ec2-user/sport-equipment-monolith/.venv/bin/python /home/ec2-user/sport-equipment-monolith/scripts/wait_for_mysql.py
ExecStart=/home/ec2-user/sport-equipment-monolith/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:80 'equipment.app:launch()'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
